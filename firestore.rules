rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shongwut.tab@mfu.ac.th' ||
        request.auth.token.email == 'info.finance@mfu.ac.th'
      );
    }

    function isValidUserPermission(data) {
      return data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 150 &&
        data.role is string &&
        (data.role == 'view' || data.role == 'edit' || data.role == 'admin');
    }

    match /user_permissions/{permissionId} {
      // Allow read so all users can verify roles
      allow read: if true;

      // Allow Super Admins or signed-in users to update permissions
      allow create, update: if isSuperAdmin() || (isSignedIn() && isValidUserPermission(request.resource.data));
      allow delete: if isSuperAdmin();
    }

    match /permission_requests/{requestId} {
      // Allow read so users can view status and admins can review
      allow read: if true;

      // Allow users to submit permission requests
      allow create, update: if true;

      // Allow deletion when processed or by admin
      allow delete: if true;
    }
  }
}
